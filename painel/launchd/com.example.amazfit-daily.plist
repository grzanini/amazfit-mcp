<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.example.amazfit-daily</string>
    <!-- Puxa os dados do Amazfit T-Rex 3 (nuvem Zepp) e recalcula Recuperação/Esforço/Sono do Painel Corpo e Dieta.
         Roda às 09:30 (depois da sincronização da manhã) e às 21:30 (pega os treinos do dia). Mac dormindo: roda ao acordar.
         Instalar:  cp ~/amazfit-mcp/painel/launchd/com.example.amazfit-daily.plist ~/Library/LaunchAgents/ && launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.example.amazfit-daily.plist
         Remover:   launchctl bootout gui/$(id -u)/com.example.amazfit-daily -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/SEU_USUARIO/amazfit-mcp/painel/scripts/daily_pull.sh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/SEU_USUARIO/amazfit-mcp</string>
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Hour</key><integer>21</integer><key>Minute</key><integer>30</integer></dict>
    </array>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>/Users/SEU_USUARIO/Library/Logs/amazfit/launchd_stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/SEU_USUARIO/Library/Logs/amazfit/launchd_stderr.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>LANG</key>
        <string>pt_BR.UTF-8</string>
    </dict>
</dict>
</plist>
